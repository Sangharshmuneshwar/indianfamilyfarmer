# ─────────────────────────────────────────────────────────────
#  Indian Family Farmer — site configuration
#  Copy this file to `.env` and fill in real values.
#  All VITE_* values are embedded in the PUBLIC JavaScript bundle.
#  Never put private secrets here.
# ─────────────────────────────────────────────────────────────

# Production domain (no trailing slash). Used for canonical URLs,
# Open Graph tags, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.your-domain.com

# WhatsApp Business number in international format, digits only,
# NO plus sign, NO spaces. Example format (not a real number): 919800000000
VITE_WHATSAPP_NUMBER=

# Business contact details shown in the footer / contact page.
# Leave blank to show a "to be added" placeholder.
VITE_BUSINESS_PHONE=
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_ADDRESS=

# Contact form provider: "web3forms" or "formspree".
# Leave blank to disable email submission (WhatsApp option still works).
VITE_FORM_PROVIDER=

# Web3Forms — public access key (https://web3forms.com).
# This key is PUBLIC by design. Restrict it to your domain in the
# Web3Forms dashboard and enable their spam protection.
VITE_WEB3FORMS_ACCESS_KEY=

# Formspree — form ID only, e.g. "xayzabcd" from https://formspree.io/f/xayzabcd
# Configure allowed domains + reCAPTCHA/spam filtering in Formspree settings.
VITE_FORMSPREE_FORM_ID=
